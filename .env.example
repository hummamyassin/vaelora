# Server-only. Never use NEXT_PUBLIC_ for AI credentials.
VAELORA_AI_PROVIDER=openai
OPENAI_API_KEY=
# Explicit model supported by the selected provider and local function calling.
VAELORA_AI_MODEL=

# Groq alternative. Set VAELORA_AI_PROVIDER=groq and choose a Groq model that
# supports local tool calling. Keep this key server-only.
GROQ_API_KEY=
